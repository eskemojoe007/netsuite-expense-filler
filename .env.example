# NetSuite settings (no credentials: login is SSO + 2FA in the browser)
# Copy this file to .env and adjust if needed.
# IMPORTANT: Never commit the .env file to git! It is already in .gitignore.
# Optional: CHROME_PATH=C:\path\to\chrome.exe if Chrome is not in a standard location.
# Optional: default folders for --trip / --extract (your real paths stay
# here in .env, never in the script):
# EXPENSE_REPORTS_ROOT=C:\path\to\Expense Reports
# EXPENSE_DOWNLOADS_DIR=C:\path\to\Downloads

NETSUITE_URL=http://netsuite.vertech.com/
